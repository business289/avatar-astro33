# Backend API Configuration
# This default only matters for one-off `vite`/`vite build` runs without a
# mode-specific file present. In this repo, .env.development (localhost) and
# .env.production (Render) already set VITE_API_URL per mode — Vite picks the
# right one automatically for `npm run dev` vs `npm run build`.
VITE_API_URL=http://localhost:5000/api

# Google Identity Services client ID (must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Environment
VITE_ENV=development

# No AI or text-to-speech provider keys belong in this file. Every VITE_* value
# is compiled into the public JavaScript bundle. The Inner Voice AI (Groq) and the
# Sarvam TTS keys are SERVER-SIDE ONLY: set GROQ_API_KEY and SARVAM_API_KEY in the
# backend environment (see backend/.env.example), not here.
