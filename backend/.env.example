# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/astrology
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/astrology

# Optional. Leave unset by default — most environments don't need this.
# Only set it if connecting fails with "querySrv ECONNREFUSED
# _mongodb._tcp.<cluster>.mongodb.net": some local/router DNS resolvers
# refuse SRV queries from Node's resolver even though the OS resolver
# handles them fine, which breaks mongodb+srv:// connection strings.
# Comma-separated list of DNS servers to use instead, e.g.:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Inner Voice AI (Karma Diagnosis, Guru Chat, Dashboard, Journal, Wisdom, Voice
# consultation). SERVER-SIDE ONLY: never put this in a VITE_* variable or in any
# frontend file. Create it at https://console.groq.com and set it in the Render
# service environment and in your private backend/.env (which is git-ignored).
GROQ_API_KEY=your_groq_api_key_here
# Optional. Defaults to openai/gpt-oss-120b (a Groq production model). Must support
# JSON mode; change it here, not in the frontend.
# GROQ_MODEL=openai/gpt-oss-120b

# Sarvam text-to-speech (server-side proxy at /api/tts)
SARVAM_API_KEY=your_sarvam_api_key_here

# YouTube Data API v3 (Live Darshan)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
# How often the background service re-checks temple live status
DARSHAN_REFRESH_INTERVAL_MINUTES=15
# Cloudinary (admin temple image uploads — server-side only, never exposed to the frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
